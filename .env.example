# Copy to .env for local runs. In GitHub these are repository secrets.
# .env is gitignored -- never commit real credentials.

# --- database -------------------------------------------------------------
# One line, copied whole from your provider's connection dialog.
# Keep ?sslmode=require. The database name here is marketdb.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/marketdb?sslmode=require

# Optional. Only needed when DATABASE_URL points at a POOLED endpoint
# (a hostname containing "-pooler") and you want migrations and VACUUM to
# use the direct endpoint. The workflows derive it automatically by
# stripping "-pooler", so you usually do not need to set this.
# DATABASE_URL_DIRECT=

# --- Databricks Lakebase OAuth (usually NOT needed) -----------------------
# Leave all four of these empty when DATABASE_URL uses a native Postgres
# password role -- those passwords do not expire, which is what you want.
#
# Fill them in only if password connections are unavailable for your
# workspace. A Lakebase OAuth token dies after 60 minutes, so a fixed
# DATABASE_URL would stop working within the hour; with these set, the
# pipeline mints a fresh token per connection and refreshes it mid-run.
# All four are required for this to engage. See docs/LAKEBASE_AUTH.md.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>
# TOKEN_REFRESH_MARGIN=300

# --- http behaviour -------------------------------------------------------
# Retries apply to transient failures only (timeouts, connection errors,
# 5xx). Quota refusals and 4xx are never retried.
HTTP_RETRIES=2
HTTP_BACKOFF=1.5

# --- api keys -------------------------------------------------------------
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# --- what to collect ------------------------------------------------------
SYMBOLS=AAPL,MSFT,GOOGL

# Daily candles per symbol per fetch. Twelve Data allows up to 5000.
DAILY_OUTPUTSIZE=100

# Intraday candles are roughly 90% of this project's storage growth.
# Set to false if you only need daily data.
INTRADAY_ENABLED=true
INTRADAY_INTERVAL=5min
INTRADAY_OUTPUTSIZE=30

# Rows kept per indicator per fetch (Alpha Vantage).
INDICATOR_MAX_RECORDS=30

# --- pacing ---------------------------------------------------------------
# Seconds to wait between calls, to stay inside provider rate limits.
SLEEP_FINNHUB=1
SLEEP_TWELVEDATA=8
SLEEP_ALPHAVANTAGE=15
HTTP_TIMEOUT=30
